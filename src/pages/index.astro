---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const landing = await getEntry('landing', 'inicio');
const { titulo, subtitulo, whatsapp, email_contacto } = landing.data;
---

<Layout title={titulo}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900">
		<!-- Hero Section -->
		<section class="px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-4xl text-center">
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-6">
					{titulo}
				</h1>
				<p class="text-lg sm:text-xl text-slate-300 mb-12 leading-relaxed">
					{subtitulo}
				</p>
			</div>
		</section>

		<!-- Contact Form Section -->
		<section class="px-4 py-16 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl">
				<div class="bg-white rounded-lg shadow-2xl p-8 sm:p-12">
					<h2 class="text-3xl font-bold text-slate-900 mb-8 text-center">
						Ponte en Contacto
					</h2>

					<form id="contactForm" class="space-y-6">
						<!-- Name Field -->
						<div>
							<label for="name" class="block text-sm font-semibold text-slate-700 mb-2">
								Nombre Completo
							</label>
							<input
								type="text"
								id="name"
								name="name"
								required
								class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
								placeholder="Tu nombre"
							/>
						</div>

						<!-- Email Field -->
						<div>
							<label for="email" class="block text-sm font-semibold text-slate-700 mb-2">
								Correo Electrónico
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
								placeholder="tu@email.com"
							/>
						</div>

						<!-- Phone Field -->
						<div>
							<label for="phone" class="block text-sm font-semibold text-slate-700 mb-2">
								Teléfono
							</label>
							<input
								type="tel"
								id="phone"
								name="phone"
								required
								class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
								placeholder="(300) 123-4567"
							/>
						</div>

						<!-- Contact Method Selection -->
						<div>
							<label class="block text-sm font-semibold text-slate-700 mb-4">
								Método de Contacto Preferido
							</label>
							<div class="space-y-3">
								<label class="flex items-center cursor-pointer">
									<input
										type="radio"
										name="contactMethod"
										value="whatsapp"
										checked
										class="w-4 h-4 text-blue-500 focus:ring-blue-500"
									/>
									<span class="ml-3 text-slate-700 font-medium">WhatsApp (Respuesta Rápida)</span>
								</label>
								<label class="flex items-center cursor-pointer">
									<input
										type="radio"
										name="contactMethod"
										value="email"
										class="w-4 h-4 text-blue-500 focus:ring-blue-500"
									/>
									<span class="ml-3 text-slate-700 font-medium">Correo Electrónico</span>
								</label>
							</div>
						</div>

						<!-- Submit Buttons -->
						<div class="flex flex-col sm:flex-row gap-4 pt-6">
							<button
								type="button"
								id="whatsappBtn"
								class="flex-1 bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg transition duration-200 ease-in-out transform hover:scale-105"
							>
								💬 Contactar por WhatsApp
							</button>
							<button
								type="submit"
								id="emailBtn"
								class="flex-1 bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-6 rounded-lg transition duration-200 ease-in-out transform hover:scale-105"
							>
								✉️ Enviar por Correo
							</button>
						</div>
					</form>

					<div id="message" class="mt-6 p-4 rounded-lg text-center hidden"></div>
				</div>
			</div>
		</section>

		<!-- Features Section -->
		<section class="px-4 py-16 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-4xl">
				<h2 class="text-3xl sm:text-4xl font-bold text-white text-center mb-12">
					¿Por Qué Elegir Grey's Auto?
				</h2>
				<div class="grid md:grid-cols-3 gap-8">
					<div class="bg-white/10 backdrop-blur-lg rounded-lg p-6 border border-white/20">
						<div class="text-4xl mb-4">🚗</div>
						<h3 class="text-xl font-bold text-white mb-3">Mejor Selección</h3>
						<p class="text-slate-300">Los mejores vehículos y repuestos del mercado con garantía de calidad.</p>
					</div>
					<div class="bg-white/10 backdrop-blur-lg rounded-lg p-6 border border-white/20">
						<div class="text-4xl mb-4">💰</div>
						<h3 class="text-xl font-bold text-white mb-3">Precios Competitivos</h3>
						<p class="text-slate-300">Ofertas increíbles con las mejores condiciones de pago.</p>
					</div>
					<div class="bg-white/10 backdrop-blur-lg rounded-lg p-6 border border-white/20">
						<div class="text-4xl mb-4">🤝</div>
						<h3 class="text-xl font-bold text-white mb-3">Soporte 24/7</h3>
						<p class="text-slate-300">Nuestro equipo siempre está listo para ayudarte con tus preguntas.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="border-t border-white/10 px-4 py-8 sm:px-6 lg:px-8 text-center text-slate-400">
			<p>&copy; 2026 Grey's Auto. Todos los derechos reservados.</p>
		</footer>
	</main>
</Layout>

<script define:vars={{ whatsapp, email_contacto }}>
	const form = document.getElementById('contactForm');
	const messageDiv = document.getElementById('message');
	const whatsappBtn = document.getElementById('whatsappBtn');
	const emailBtn = document.getElementById('emailBtn');

	whatsappBtn.addEventListener('click', async (e) => {
		e.preventDefault();
		const name = document.getElementById('name').value;
		const phone = document.getElementById('phone').value;
		const email = document.getElementById('email').value;

		if (!name || !phone || !email) {
			showMessage('Por favor, completa todos los campos.', 'error');
			return;
		}

		try {
			const formData = new FormData();
			formData.append('name', name);
			formData.append('phone', phone);
			formData.append('email', email);
			formData.append('source', 'WhatsApp Lead');

			await fetch('https://web3forms.com/api/send', {
				method: 'POST',
				body: formData,
				headers: { 'access_key': email_contacto }
			});
		} catch (error) {
			console.log('Email de respaldo omitido');
		}

		const message = `¡Hola! Mi nombre es ${name}. Me gustaría información. Tel: ${phone}, Email: ${email}`;
		const whatsappUrl = `https://wa.me/${whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(message)}`;
		window.open(whatsappUrl, '_blank');

		showMessage('Redirigiendo a WhatsApp...', 'success');
		setTimeout(() => form.reset(), 2000);
	});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const name = document.getElementById('name').value;
		const phone = document.getElementById('phone').value;
		const email = document.getElementById('email').value;

		if (!name || !phone || !email) {
			showMessage('Por favor, completa todos los campos.', 'error');
			return;
		}

		try {
			const formData = new FormData();
			formData.append('name', name);
			formData.append('phone', phone);
			formData.append('email', email);
			formData.append('from_name', "Grey's Auto");

			const response = await fetch('https://web3forms.com/api/send', {
				method: 'POST',
				body: formData,
				headers: { 'access_key': email_contacto }
			});

			if (response.ok) {
				showMessage('✓ ¡Mensaje enviado! Nos pondremos en contacto pronto.', 'success');
				form.reset();
			} else {
				showMessage('✗ Error al enviar. Intenta de nuevo.', 'error');
			}
		} catch (error) {
			showMessage('✗ Error al enviar. Intenta de nuevo.', 'error');
		}
	});

	function showMessage(text, type) {
		messageDiv.textContent = text;
		messageDiv.className = `mt-6 p-4 rounded-lg text-center font-semibold ${
			type === 'success'
				? 'bg-green-500/20 border border-green-500 text-green-200'
				: 'bg-red-500/20 border border-red-500 text-red-200'
		}`;
		messageDiv.classList.remove('hidden');
		setTimeout(() => {
			messageDiv.classList.add('hidden');
		}, 4000);
	}
</script>
